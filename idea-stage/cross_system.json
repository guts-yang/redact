  "claims": {
    "C0_split_validity": {
      "status": "DEFECT_CONFIRMED",
      "why": "The shipped checkpoint does not reproduce forget01 entities (prior documented evidence: teacher-forced gold-answer NLL 5.4692, generative reproduction <= 0.083, R-TOFU/workspace/idea-stage/CHAMPION_LOGIC.md 1.1). Every leak rate computed on forget01 therefore mixes 'never knew' with 'collapsed' and cannot be read as forgetting.",
      "consequence": "All numbers in this file are reclassified as a demonstration of how the metric moves with generation state. They are NOT forgetting measurements. The valid measurement is b12_noecho_audit.json (forget10 no-echo probes, where the same checkpoint reproduces the entity 16/16 and a low reading would mean forgetting)."
    },
    "C1_state_confound": {
      "status": "SUPPORTED",
      "why": "raw leak rate across the five systems spans 0.0-0.16875 while collapsed_rate spans 0.0-0.9625; r2mu05 reports raw_leak=0.0 with ~1.0 collapse, i.e. the zero is produced by degenerate text, not by forgetting."
    },
    "C2_reranking": {
      "status": "NOT_SUPPORTED_ON_A_VALID_SPLIT",
      "systems_moved_off_the_rankable_set": [
        "ctrl-single",
        "ours-inv",
        "r2mu05",
        "target"
      ],
      "why": "A system is only rankable if at least one state cell has >=8 clean samples, and on forget01 4 of 5 systems fail that test. But forget01 is not a split this checkpoint ever learned (see C0), so 'unevaluable' here reflects a never-known regime, not a forgetting measurement. The reclassification cannot be used as evidence.",
      "what_would_support_it": "repeat the audit on forget10 (the split the checkpoint knows) across the unlearned systems trained on that same split",
      "honest_limit": "clean_cell_leak = 0 in every estimable cell on forget01, while the same checkpoint shows clean_cell_leak = 1.0 on forget10 no-echo probes. The two readings cannot both describe forgetting; the split decides."
    },
    "C1b_valid_split_measurement": {
      "status": "SUPPORTED",
      "source": "b12_noecho_audit.json",
      "why": "On 16 echo-free forget10 probes the checkpoint leaks 16/16 under DefaultCoT and 6/16 under ZeroThink at the same 512-token budget, and the leak rate does not move with budget for any strategy. The decoding-path gap (0.625) survives removal of the echo confound; the budget effect does not."
    },
    "C3_judge": {
      "status": "PARTIAL",
      "why": "agreement=1.0 on 30/32 judged samples; the 2 failed calls are unlabelled."
    },
    "C4_censoring_bound": {
      "status": "REFUTED_ON_THIS_BATCH",
      "why": "the interval width is 0 wherever every sample already leaks; no preregistered decision threshold exists to compare against."
    }
  },
  "taxonomy_caveat": "Four states are not enough: ours-inv and ctrl-single DefaultCoT have answer_reached=0 with truncated=0, i.e. the answer channel is absent without truncation. That is a fifth state (no-answer-channel) and is reported separately."
}
