  "claims": {
    "C0_scenario_ratio": {
      "status": "CONDITION_NOT_DEFECT",
      "why": "forget01 / forget05 / forget10 are three forgetting-RATIO scenarios (1% / 5% / 10%), not three checkpoints' knowledge states. A table that lines up systems trained on different ratios confounds ratio with method; a read of one ratio still requires the state stratum before the sign of a delta means anything.",
      "consequence": "Numbers in this file are a within-forget01 (1%) state demonstration. They are not comparable with forget10 readings, and neither set is interpretable without the per-cell state mix.",
      "retracted": "An earlier revision claimed the checkpoint had never learned forget01 (based on R-TOFU/workspace/idea-stage/CHAMPION_LOGIC.md 1.1). That reading was wrong: the scenario/ratio framing supersedes it, and the prior NLL evidence is itself in conflict with the local teacher-forced NLL (see b17_calibration_failure.json)."
    },
    "C1_state_confound": {
      "status": "SUPPORTED",
      "why": "raw leak rate across the five systems spans 0.0-0.16875 while collapsed_rate spans 0.0-0.9625; r2mu05 reports raw_leak=0.0 with ~1.0 collapse, i.e. the zero is produced by degenerate text, not by forgetting."
    },
    "C2_reranking": {
      "status": "SUPPORTED_ON_UNEVALUABILITY",
      "systems_moved_off_the_rankable_set": [
        "ctrl-single",
        "ours-inv",
        "r2mu05",
        "target"
      ],
      "why": "Within the 1% scenario a system is only rankable if at least one state cell has >= 8 clean samples; 4 of 5 fail that test. The change is a change of STATUS (from 'forgotten' to 'unevaluable'), not a demonstrated reversal of an ordering.",
      "what_would_support_a_reversal": "a cell with a nonzero clean leak on two systems in the same ratio scenario",
      "honest_limit": "clean_cell_leak = 0 in every estimable cell on forget01, while the same checkpoint shows clean_cell_leak = 1.0 on forget10 no-echo probes. The ratio scenario and the state mix decide the reading; the metric alone does not."
    },
    "C1b_within_scenario_measurement": {
      "status": "SUPPORTED",
      "source": "b12_noecho_audit.json + b18_scenario_panels.json",
      "why": "On 16 echo-free forget10 probes the checkpoint leaks 16/16 under DefaultCoT and 6/16 under ZeroThink at the same 512-token budget; the leak rate does not move with budget for any strategy. The decoding-path gap (0.625) survives removal of the echo confound; the budget effect does not.",
      "cross_panel": "forget01 goes 0.025 -> 0.169 after unlearning (collapse 88.8% -> 15.6%) while forget10 goes 1.000 -> 0.000 (collapse 0% -> 87.5%, clean_n 2 -> unevaluable). Opposite signs, same metric, state-driven."
    },
    "C3_judge": {
      "status": "PARTIAL",
      "why": "agreement=1.0 on 30/32 judged samples; the 2 failed calls are unlabelled."
    },
    "C4_censoring_bound": {
      "status": "REFUTED_ON_THIS_BATCH",
      "why": "the interval width is 0 wherever every sample already leaks; no preregistered decision threshold exists to compare against."
    }
  },
  "taxonomy_caveat": "Four states are not enough: ours-inv and ctrl-single DefaultCoT have answer_reached=0 with truncated=0, i.e. the answer channel is absent without truncation. That is a fifth state (no-answer-channel) and is reported separately."
}
