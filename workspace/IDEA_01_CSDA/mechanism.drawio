        </mxCell>
        <mxCell id="in" value="&lt;b&gt;遗忘集合&lt;/b&gt;  D_f =(x, CoT, answer)&lt;br&gt;$$e_f = \text{forget 实体}$$&lt;br&gt;&lt;br&gt;&lt;b&gt;保留集合&lt;/b&gt;  D_r = retain / aux prompt&lt;br&gt;$$\theta_0 = \text{冻结 target 模型}$$" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="176" width="400" height="740" as="geometry" />
        </mxCell>
        <mxCell id="emb" value="&lt;b&gt;模型入口 / 前向起点&lt;/b&gt;&lt;br&gt;$$\mathrm{Emb}(x)\rightarrow h^{(0)}$$&lt;br&gt;&lt;br&gt;$$\phi_\theta^{(\ell)}(r_t)\quad(\text{第 }\ell\text{ 层 · 第 }t\text{ 个 CoT 步})$$&lt;br&gt;&lt;br&gt;$$\text{base 权重冻结；仅挂载 LoRA 适配器}$$&lt;br&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="176" width="360" height="740" as="geometry" />
        </mxCell>
        <mxCell id="proc" value="&lt;b&gt;③ 前向传播 + 步级因果归因&lt;/b&gt;&lt;br&gt;$$\mathcal{T}=(r_1,\dots,r_T;a),\quad h_t=\phi_\theta^{(\ell)}(r_t)$$&lt;br&gt;&lt;br&gt;$$c_t=\mathbb{E}_{x\in D_f}\big[\ell_{leak}(a\mid\mathrm{do}(\phi(r_t)\leftarrow\tilde\phi_t))-\ell_{leak}(a\mid\mathcal{T})\big]$$&lt;br&gt;&lt;br&gt;$$m_t=\sigma\!\big((c_t-\tau)/\kappa\big),\quad \min\|\mathbf{m}\|_0\ \ \mathrm{s.t.}\ \mathrm{Leak}(\mathcal{T}\mid\mathbf{m})\le\varepsilon$$&lt;br&gt;&lt;br&gt;$$\text{输出：}\ \mathrm{logit}(e_f\mid r_{\le t})\ \text{与承重步掩码 }m_t$$&lt;br&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="940" y="176" width="740" height="740" as="geometry" />
        </mxCell>
        <mxCell id="loss" value="&lt;b&gt;④ 损失函数&lt;/b&gt;&lt;br&gt;$$\mathcal{L}_{CSDA}=\sum_{t=1}^{T}m_t\|\phi_\theta(r_t)-v_{safe}\|_2^2+\lambda\,\mathrm{KL}(p_\theta\|p_{\theta_0})+\mu\!\sum_{t:m_t=0}\!\|\phi_\theta(r_t)-\phi_{\theta_0}(r_t)\|_2^2$$&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;④ 反向传播 / 优化参数（承接损失梯度）&lt;/b&gt;&lt;br&gt;$$g=\nabla_\theta\mathcal{L}_{CSDA},\qquad \theta\leftarrow\theta-\eta\,g$$&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&#x27;left&#x27;&gt;仅更新 LoRA 适配器 A,B（r=8，q/k/v/o/gate/up/down_proj）；v_safe 由 retain CoT 均值固定；base θ₀ 与归因缓存冻结。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1760" y="176" width="830" height="740" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;输出产物&lt;/b&gt;&lt;br&gt;$$\theta=\mathrm{Unlearn}(\theta_0)$$&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&#x27;center&#x27;&gt;具备遗忘能力的模型：承重步被重定向，非承重推理步结构保持。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="2670" y="176" width="290" height="740" as="geometry" />
        </mxCell>
