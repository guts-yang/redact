        <mxCell id="in" value="&lt;b&gt;遗忘集合&lt;/b&gt;  D_f =(x, CoT, answer)&lt;br&gt;$$e_f = \text{forget 实体}$$&lt;br&gt;&lt;br&gt;&lt;b&gt;保留集合&lt;/b&gt;  D_r = retain / aux prompt&lt;br&gt;$$\theta_0 = \text{冻结 target 模型}$$" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="176" width="400" height="740" as="geometry" />
        </mxCell>
        <mxCell id="emb" value="&lt;b&gt;模型入口 / 前向起点&lt;/b&gt;&lt;br&gt;$$\mathrm{Emb}(x)\rightarrow h^{(0)}$$&lt;br&gt;&lt;br&gt;$$\phi_\theta^{(\ell)}(r_t)\quad(\text{第 }\ell\text{ 层 · 第 }t\text{ 个 CoT 步})$$&lt;br&gt;&lt;br&gt;$$\text{base 权重冻结；仅挂载 LoRA 适配器}$$&lt;br&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="176" width="360" height="740" as="geometry" />
        </mxCell>
        <mxCell id="proc" value="&lt;b&gt;③ 前向传播 + 涟漪邻域&lt;/b&gt;&lt;br&gt;$$\mathcal{N}_\rho(x_f)=\{x:d_{sem}(\phi(x),\phi(x_f))\le\rho\}$$&lt;br&gt;&lt;br&gt;$$\mathcal{H}_H(x_f)=\{x:\mathrm{hop}_{\mathcal{G}}(x,x_f)\le H\}$$&lt;br&gt;&lt;br&gt;$$\phi_\theta(CoT(x))\ \text{对邻近集与多跳集分别前向}$$&lt;br&gt;&lt;br&gt;$$\mathcal{L}_{pathcut}=\max\big(0,\mathrm{sim}(\phi_\theta(CoT(x)),\phi_{\theta_0}(CoT(x_f)))-\tau\big)$$&lt;br&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="940" y="176" width="740" height="740" as="geometry" />
        </mxCell>
        <mxCell id="loss" value="&lt;b&gt;④ 损失函数（局部化双约束）&lt;/b&gt;&lt;br&gt;$$\mathcal{L}_{RIPPLE}=\mathcal{L}_{forget}(x_f)+\lambda_1\!\sum_{x\in\mathcal{N}_\rho}\!\mathrm{KL}(p_\theta\|p_{\theta_0})+\lambda_2\!\sum_{x\in\mathcal{H}_H}\!\mathcal{L}_{pathcut}(x,x_f)$$&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;④ 反向传播 / 优化参数（承接损失梯度）&lt;/b&gt;&lt;br&gt;$$\theta\leftarrow\theta-\eta\nabla_\theta\mathcal{L}_{RIPPLE}$$&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&#x27;left&#x27;&gt;更新 LoRA 参数 θ；知识图 G、d_sem、集合 N_ρ/H_H 与 θ₀ 均冻结预计算。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1760" y="176" width="830" height="740" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;输出产物&lt;/b&gt;&lt;br&gt;$$\theta=\mathrm{Unlearn}(\theta_0)$$&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&#x27;center&#x27;&gt;具备遗忘能力的模型：邻近知识保留、多跳重建路径被剪断。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="2670" y="176" width="290" height="740" as="geometry" />
        </mxCell>
