        <mxCell id="in" value="&lt;b&gt;遗忘集合&lt;/b&gt;  D_f =(x, CoT, answer)&lt;br&gt;$$e_f = \text{forget 实体}$$&lt;br&gt;&lt;br&gt;&lt;b&gt;保留集合&lt;/b&gt;  D_r = retain / aux prompt&lt;br&gt;$$\theta_0 = \text{冻结 target 模型}$$" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="176" width="400" height="740" as="geometry" />
        </mxCell>
        <mxCell id="emb" value="&lt;b&gt;模型入口 / 前向起点&lt;/b&gt;&lt;br&gt;$$\mathrm{Emb}(x)\rightarrow h^{(0)}$$&lt;br&gt;&lt;br&gt;$$\phi_\theta^{(\ell)}(r_t)\quad(\text{第 }\ell\text{ 层 · 第 }t\text{ 个 CoT 步})$$&lt;br&gt;&lt;br&gt;$$\text{base 权重冻结；仅挂载 LoRA 适配器}$$&lt;br&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="500" y="176" width="360" height="740" as="geometry" />
        </mxCell>
        <mxCell id="proc" value="&lt;b&gt;③ 前向传播 + 纠缠度路由&lt;/b&gt;&lt;br&gt;$$\kappa(x)=\frac{1}{|N_1(x)|}\sum_{q\in N_1(x)}\mathrm{sim}(\phi(x),\phi(q))\,\mathrm{cooccur}(e_f,q)$$&lt;br&gt;&lt;br&gt;$$d(x)=\mathrm{depth}(\mathrm{circuit}(x)),\qquad \alpha(x)=\sigma\big(w^\top[\kappa(x),d(x),1]\big)\in[0,1]$$&lt;br&gt;&lt;br&gt;$$\alpha(x)\Rightarrow\mathcal{L}_{repr}(x)\ (\text{表示级}),\quad (1-\alpha(x))\Rightarrow\mathcal{L}_{out}(x)\ (\text{输出级})$$&lt;br&gt;&lt;br&gt;$$\text{输出：}\ \text{逐样本干预路径与损失组合}$$&lt;br&gt;&lt;br&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="940" y="176" width="740" height="740" as="geometry" />
        </mxCell>
        <mxCell id="loss" value="&lt;b&gt;④ 损失函数（预算约束）&lt;/b&gt;&lt;br&gt;$$\mathcal{L}_{EAS}=\alpha(x)\mathcal{L}_{repr}+(1-\alpha(x))\mathcal{L}_{out}+\lambda(\kappa)\,\mathrm{KL}(p_\theta\|p_{\theta_0}),\quad \lambda(\kappa)=\lambda_0(1+\kappa)$$&lt;br&gt;&lt;br&gt;$$\min_{\theta,w}\mathrm{Utility}(\theta)\ \ \mathrm{s.t.}\ \sum_x\mathrm{cost}(\alpha(x))\le B,\ \mathrm{Leak}\le\varepsilon$$&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;④ 反向传播 / 优化参数（承接损失梯度）&lt;/b&gt;&lt;br&gt;$$\theta\leftarrow\theta-\eta\nabla_\theta\mathcal{L}_{EAS}$$&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&#x27;left&#x27;&gt;更新 LoRA 参数 θ 与调度权重 w；κ,d 由冻结 KB/电路预计算；target θ₀ 冻结。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1760" y="176" width="830" height="740" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;输出产物&lt;/b&gt;&lt;br&gt;$$\theta=\mathrm{Unlearn}(\theta_0)$$&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;div align=&#x27;center&#x27;&gt;具备遗忘能力的模型：干预强度已按样本纠缠度分配。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="2670" y="176" width="290" height="740" as="geometry" />
        </mxCell>
