        <mxCell id="in" value="&lt;b&gt;遗忘集合&lt;/b&gt;  D_f =(x, CoT, answer)&lt;br&gt;$$e_f = \text{forget 实体}$$&lt;br&gt;&lt;b&gt;保留集合&lt;/b&gt;  D_r = retain / aux prompt&lt;br&gt;$$\theta_0 = \text{冻结 target 模型}$$" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="208.10000000000002" width="400" height="226.79999999999995" as="geometry" />
        </mxCell>
        <mxCell id="emb" value="&lt;b&gt;模型入口 / 前向起点&lt;/b&gt;&lt;br&gt;$$\mathrm{Emb}(x)\rightarrow h^{(0)}$$&lt;br&gt;$$\phi_\theta^{(\ell)}(r_t)\quad(\text{第 }\ell\text{ 层 · 第 }t\text{ 个 CoT 步})$$&lt;br&gt;$$\text{base 权重冻结；仅挂载 LoRA 适配器}$$" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="530" y="205.9" width="360" height="231.2" as="geometry" />
        </mxCell>
        <mxCell id="proc" value="&lt;b&gt;③ 前向传播 + 推理子空间估计&lt;/b&gt;&lt;br&gt;$$C_r=\frac{1}{N}\sum_t(h_t-\bar h)(h_t-\bar h)^\top,\quad U=\mathrm{eigvec}_{top\text{-}k}(C_r)$$&lt;br&gt;$$S_r=\mathrm{span}(U),\qquad P_\perp=I-UU^\top$$&lt;br&gt;$$h_t=\phi_\theta^{(\ell)}(r_t)\ \text{在 retain / 数学 CoT 上估计}$$&lt;br&gt;$$g_f^\perp=P_\perp\,\nabla_\theta\mathcal{L}_{forget}\quad(\text{梯度正交投影})$$" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="980" y="168.0" width="740" height="307.0" as="geometry" />
        </mxCell>
        <mxCell id="loss" value="&lt;b&gt;④ 损失函数&lt;/b&gt;&lt;br&gt;$$\mathcal{L}_{ORTHO}=\mathcal{L}_{forget}+\mu\|U^\top(\phi_\theta-\phi_{\theta_0})\|_F^2+\lambda\,\mathrm{KL}(p_\theta\|p_{\theta_0})$$&lt;br&gt;$$\mathrm{Collapse}\le\kappa\|U^\top\Delta\phi\|_F+\mathcal{O}(\|\Delta\phi\|^2)$$&lt;br&gt;&lt;b&gt;④ 反向传播 / 优化参数（承接损失梯度）&lt;/b&gt;&lt;br&gt;$$\theta\leftarrow\theta-\eta\big(g_f^\perp+\lambda\,g_r\big)$$&lt;br&gt;&lt;div align=&#x27;left&#x27;&gt;更新 LoRA 参数 θ，但仅沿 P⊥ 方向；U 由冻结 θ₀ 的 retain 激活一次性估计并冻结。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1810" y="172.75" width="830" height="297.5" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;输出产物&lt;/b&gt;&lt;br&gt;$$\theta=\mathrm{Unlearn}(\theta_0)$$&lt;br&gt;&lt;div align=&#x27;center&#x27;&gt;具备遗忘能力的模型：推理方向 S_r 未被扰动，无 collapse。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
