        <mxCell id="in" value="&lt;b&gt;遗忘集合&lt;/b&gt;  D_f =(x, CoT, answer)&lt;br&gt;$$e_f = \text{forget 实体}$$&lt;br&gt;&lt;b&gt;保留集合&lt;/b&gt;  D_r = retain / aux prompt&lt;br&gt;$$\theta_0 = \text{冻结 target 模型}$$" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="208.10000000000002" width="400" height="226.79999999999995" as="geometry" />
        </mxCell>
        <mxCell id="emb" value="&lt;b&gt;模型入口 / 前向起点&lt;/b&gt;&lt;br&gt;$$\mathrm{Emb}(x)\rightarrow h^{(0)}$$&lt;br&gt;$$\phi_\theta^{(\ell)}(r_t)\quad(\text{第 }\ell\text{ 层 · 第 }t\text{ 个 CoT 步})$$&lt;br&gt;$$\text{base 权重冻结；仅挂载 LoRA 适配器}$$" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="530" y="205.9" width="360" height="231.2" as="geometry" />
        </mxCell>
        <mxCell id="proc" value="&lt;b&gt;③ 前向传播 + 承诺边界检测&lt;/b&gt;&lt;br&gt;$$\tau^*=\min\{t:\ \mathrm{JS}(p_t(\cdot),p_{t+1}(\cdot))\le\delta_{JS},\ \forall t&#x27;\ge t\}$$&lt;br&gt;$$\hat\tau\approx\tau^*\quad(\text{步级熵 / 激活检测})$$&lt;br&gt;$$y_{exit}=\texttt{SAFE\_COT}(r_{\le\hat\tau})\oplus\texttt{IDK}\quad(\text{边界处干净退出})$$&lt;br&gt;$$[\,lo,hi\,]=\Big[\frac{\ell}{n},\min(1,\frac{\ell+u}{n})\Big],\quad W=hi-lo\le 0.2$$" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="980" y="168.0" width="740" height="307.0" as="geometry" />
        </mxCell>
        <mxCell id="loss" value="&lt;b&gt;④ 损失函数（多预算最坏情况）&lt;/b&gt;&lt;br&gt;$$\mathcal{L}_{bound}=\max_{b\in\{96,192,512,1024\}}\big[\mathcal{L}_{leak}(\theta;b)+\zeta\,\mathcal{L}_{exit}(\theta;b)\big]$$&lt;br&gt;$$\mathcal{L}_{exit}=\mathrm{CE}(y_{exit}\mid x)+\mu\,\mathcal{L}_{forget}(r_{\le\hat\tau})$$&lt;br&gt;&lt;b&gt;④ 反向传播 / 优化参数（承接损失梯度）&lt;/b&gt;&lt;br&gt;$$\theta\leftarrow\theta-\eta\nabla_\theta\mathcal{L}_{bound}$$&lt;br&gt;&lt;div align=&#x27;left&#x27;&gt;更新 LoRA 参数 θ（边界处生成安全退出轨迹）；τ̂ 为检测量非参数；θ₀ 冻结。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1810" y="172.75" width="830" height="297.5" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;输出产物&lt;/b&gt;&lt;br&gt;$$\theta=\mathrm{Unlearn}(\theta_0)$$&lt;br&gt;&lt;div align=&#x27;center&#x27;&gt;具备遗忘能力的模型：承诺边界即停止，输出可判定而非删失。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
