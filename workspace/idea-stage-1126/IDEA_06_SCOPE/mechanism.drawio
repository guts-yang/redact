        <mxCell id="in" value="&lt;b&gt;遗忘集合&lt;/b&gt;  D_f =(x, CoT, answer)&lt;br&gt;$$e_f = \text{forget 实体}$$&lt;br&gt;&lt;b&gt;保留集合&lt;/b&gt;  D_r = retain / aux prompt&lt;br&gt;$$\theta_0 = \text{冻结 target 模型}$$" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=14;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="203.35000000000002" width="400" height="226.79999999999995" as="geometry" />
        </mxCell>
        <mxCell id="emb" value="&lt;b&gt;模型入口 / 前向起点&lt;/b&gt;&lt;br&gt;$$\mathrm{Emb}(x)\rightarrow h^{(0)}$$&lt;br&gt;$$\phi_\theta^{(\ell)}(r_t)\quad(\text{第 }\ell\text{ 层 · 第 }t\text{ 个 CoT 步})$$&lt;br&gt;$$\text{base 权重冻结；仅挂载 LoRA 适配器}$$" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="530" y="201.15" width="360" height="231.2" as="geometry" />
        </mxCell>
        <mxCell id="proc" value="&lt;b&gt;③ 前向传播 + 步级等价类标注&lt;/b&gt;&lt;br&gt;$$[x]_T=\{\tilde x:\tilde x\sim_T x\},\qquad g_t=\mathbb{1}[r_t\in\text{in-scope 等价类}]$$&lt;br&gt;$$\forall\tilde x\in[x]_T:\ p_\theta(e_f\mid r_{\le t})\ \text{逐 CoT 步前向}$$&lt;br&gt;$$\mathrm{SCS}=\frac{1}{|[x]_T|}\sum_{\tilde x}\min_t\mathbb{1}[\mathrm{Leak}(r_t(\tilde x))\le\varepsilon]\to 1$$" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=15;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="980" y="188.75" width="740" height="256.0" as="geometry" />
        </mxCell>
        <mxCell id="loss" value="&lt;b&gt;④ 损失函数（step-wise scope）&lt;/b&gt;&lt;br&gt;$$\mathcal{L}_{SCOPE}=\sum_{x\in D_f}\sum_{t=1}^{T}\big[g_t\mathcal{L}_{sup}(r_t)+(1-g_t)\mathcal{L}_{keep}(r_t)\big]+\lambda\mathcal{L}_r$$&lt;br&gt;$$\mathcal{L}_{sup}=-\log(1-p_\theta(e_f\mid r_{\le t})),\quad \mathcal{L}_{keep}=\mathrm{KL}(p_\theta\|p_{\theta_0})$$&lt;br&gt;&lt;b&gt;④ 反向传播 / 优化参数（承接损失梯度）&lt;/b&gt;&lt;br&gt;$$\theta\leftarrow\theta-\eta\nabla_\theta\mathcal{L}_{SCOPE}$$&lt;br&gt;&lt;div align=&#x27;left&#x27;&gt;更新 LoRA 参数 θ；g_t 由冻结等价类标注器给出；θ₀ 与改写库冻结。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="1810" y="168.0" width="830" height="297.5" as="geometry" />
        </mxCell>
        <mxCell id="out" value="&lt;b&gt;输出产物&lt;/b&gt;&lt;br&gt;$$\theta=\mathrm{Unlearn}(\theta_0)$$&lt;br&gt;&lt;div align=&#x27;center&#x27;&gt;具备遗忘能力的模型：等价问法下每一步推理都被抑制。&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=5;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=13;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="2730" y="231.05" width="290" height="171.4" as="geometry" />
        </mxCell>
